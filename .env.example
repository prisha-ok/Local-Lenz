# Local Lenz — Environment Variables Example
# Copy this file to .env if using a build tool / Node.js server.
# For plain HTML/JS, values go directly in js/supabase-config.js
# The ANON key is public. NEVER commit the SERVICE_ROLE key.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=eyJ...your_public_anon_key...

# SERVICE_ROLE key — NEVER use in frontend. Server/backend only.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...NEVER_IN_FRONTEND...

# Google Gemini API Key for AI travel synthesis. Server/backend only.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_from_aistudio.google.com