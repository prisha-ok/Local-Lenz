# Local Lenz — Environment Variables Example
# Copy to .env for local development. Never commit the real .env.

# Supabase (the ANON key is public by design; never use the SERVICE_ROLE key here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

PORT=3000
NODE_ENV=development

# Google Gemini — AI travel synthesis. Server/backend only.
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud Places API (New) — city autocomplete + live Explore destinations.
# Enable "Places API (New)" at console.cloud.google.com, then create an API key.
GOOGLE_MAPS_API_KEY=your_google_cloud_maps_api_key
